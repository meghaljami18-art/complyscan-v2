# Runtime
APP_ENV=preview

# Persistence — use a pooled PostgreSQL URL at runtime.
DATABASE_URL=
ALLOW_MEMORY_FALLBACK=false

# Authentication
# For a public SIH preview only: APP_ENV=preview and AUTH_MODE=demo.
# For a production deployment use AUTH_MODE=jwt and configure all three values below.
AUTH_MODE=demo
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_ALGORITHM=RS256

# Vision — server-side only; never prefix this key with NEXT_PUBLIC_.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VISION_TIMEOUT_SECONDS=90
VISION_MAX_ATTEMPTS=3
VISION_MAX_IMAGES=6
VISION_MAX_INLINE_BYTES=12000000

# Object storage — populated when a private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=
OBJECT_ALLOWED_HOSTS=.blob.vercel-storage.com

# Rules and provenance
RULESET_ID=LMPC_MVP
RULESET_VERSION=LMPC_2026_08_26

# Same-origin on Vercel. For local web development only, put this in apps/web/.env.local:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# API_INTERNAL_BASE_URL=http://127.0.0.1:8000

# Local CORS only. Production uses same-origin Vercel Services routing.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
